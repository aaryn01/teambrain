# FalkorDB (FalkorDB Cloud: Instance > Connectivity; local Docker: localhost / 6379, no auth)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_NAME=teambrain

# Any OpenAI-compatible LLM. Gemini (free key: https://aistudio.google.com/apikey):
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash
# OpenAI instead: leave LLM_BASE_URL empty and set LLM_MODEL=gpt-4o-mini

# Set to false on a public deployment to hide the "Reset demo data" endpoint
ALLOW_RESET=true
