# FalkorDB (FalkorDB Cloud: Instance > Connectivity; local Docker: localhost / 6379, no auth)
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=
GRAPH_NAME=teambrain

# Any OpenAI-compatible LLM. Gemini (free key: https://aistudio.google.com/apikey):
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-3.5-flash-lite
LLM_REASONING_EFFORT=low
# Free Gemini keys allow ~5 requests/min per model; on 429/503 the app rotates to these:
LLM_FALLBACK_MODELS=gemini-flash-lite-latest,gemini-3-flash-preview,gemini-3.5-flash
# OpenAI instead: leave LLM_BASE_URL and LLM_REASONING_EFFORT empty, set LLM_MODEL to an OpenAI model

# Set to false on a public deployment to hide the "Reset demo data" endpoint
ALLOW_RESET=true
